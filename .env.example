# Root environment for docker-compose.prod.yml.
# Copy to `.env` and fill in real values. This file is NOT loaded by the apps
# directly — it is consumed by docker compose to interpolate variables in
# docker-compose.prod.yml. App-level SaaS keys (S3, SES, Stripe, Twilio, KVK,
# Sentry, PostHog…) live in apps/api/.env (see apps/api/.env.example).

# ---- Stack hosts (used by compose networking) ----
FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL is inlined into the web bundle at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ---- Postgres (compose service; override for managed Postgres like Neon) ----
POSTGRES_USER=offermarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=offermarket

# ---- Secrets required to boot the API (generate strong values) ----
# openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# 32-character key for worker-PII field encryption
ENCRYPTION_KEY=

# ---- Managed-service connection strings (production) ----
# When set, these take precedence over the compose-provisioned services.
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public
# REDIS_URL=redis://host:6379