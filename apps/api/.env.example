# OfferMarket API - Environment Variables

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
# Comma-separated list of allowed frontend origins (HTTP CORS + Socket.IO CORS).
# Dev uses *.localhost subdomains for locale routing (en=offermarket.localhost,
# nl=offermarket-nl.localhost). Prod: https://offermarket.eu,https://offermarket.nl
FRONTEND_URL=http://localhost:3000,http://offermarket.localhost:3000,http://offermarket-nl.localhost:3000

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://offermarket:offermarket@localhost:5432/offermarket?schema=public"
DIRECT_URL="postgresql://offermarket:offermarket@localhost:5432/offermarket?schema=public"

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET="change-this-in-production"
JWT_REFRESH_SECRET="change-this-in-production"

# =============================================================================
# FIRST-RUN BOOTSTRAP (admin + support accounts)
# =============================================================================
# These seed the FIRST admin/support users before any admin exists to log in.
# Used by `npm run db:seed` (apps/api/src/prisma/seed.ts). The seed is idempotent
# (findUnique then create) so it is safe to re-run. In production ALWAYS set
# these to real values — if omitted, the seed falls back to the hardcoded
# admin@offermarket.com / Admin123! (and support@offermarket.com / Support123!),
# which are public in the repo and MUST NOT be left active in production.
INITIAL_ADMIN_EMAIL=admin@offermarket.com
INITIAL_ADMIN_PASSWORD=
INITIAL_SUPPORT_EMAIL=support@offermarket.com
INITIAL_SUPPORT_PASSWORD=

# Shared secret gating the bootstrap-only `POST /api/v1/auth/register/admin`
# endpoint (auth.service.ts:registerAdmin) — an alternative to the seed for
# creating the first admin when you don't have DB shell access. Generate a
# long random value (openssl rand -hex 24), use it once, then UNSET it so the
# endpoint can't be reused. Leave empty to disable the endpoint (it rejects all
# calls). Not used by the seed script.
ADMIN_REGISTRATION_CODE=

# =============================================================================
# ENCRYPTION (for worker PII)
# =============================================================================
ENCRYPTION_KEY="32-character-encryption-key-here"

# =============================================================================
# EMAIL (transactional email — Brevo is the active provider)
# =============================================================================
# Provider: `log` (dev/test — captures to an in-memory outbox, no network) or
# `brevo` (production — sends via Brevo's Transactional Email API). When set to
# `brevo` in production, BREVO_API_KEY is required or the API refuses to boot.
EMAIL_PROVIDER=log
EMAIL_FROM_EMAIL=noreply@offermarket.eu
EMAIL_FROM_NAME=OfferMarket
EMAIL_REPLY_TO=
# Outbox dispatcher: drains the EmailOutbox on an interval. Set to `false` to
# disable (e.g. for worker processes that should not send mail).
EMAIL_OUTBOX_DISPATCHER_ENABLED=true
# Brevo (https://developers.brevo.com)
BREVO_API_KEY=
BREVO_API_BASE=https://api.brevo.com/v3
BREVO_MAX_RETRIES=0
# Brevo event webhook. Brevo webhooks are NOT signed, so the shared secret below
# is embedded in the unguessable URL path: POST /api/v1/webhooks/brevo/<secret>.
# Use a long random URL-safe value (hex / base64url / uuid). Leave empty to
# disable the webhook (it will reject all calls).
BREVO_WEBHOOK_SECRET=
# Legacy SES vars (not wired up; EMAIL_FROM_EMAIL falls back to SES_FROM_EMAIL)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@offermarket.eu

# =============================================================================
# SMS (Twilio or alternative)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# FILE STORAGE (S3)
# =============================================================================
AWS_S3_BUCKET=offermarket-documents
AWS_S3_REGION=eu-west-1

# =============================================================================
# VERIFICATION SERVICES
# =============================================================================
# Dutch KvK API (for employer verification)
KVK_API_KEY=
KVK_API_URL=https://api.kvk.nl/

# =============================================================================
# PAYMENTS (Stripe)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INTRODUCTION=

# =============================================================================
# ANALYTICS
# =============================================================================
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# MONITORING
# =============================================================================
SENTRY_DSN=
